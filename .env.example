# BSD API
BSD_API_KEY=your_token_here
BSD_BASE_URL=https://sports.bzzoiro.com/api/v2

# Database. Postgres recommandé en prod (écritures concurrentes du scheduler).
# Pour tester en local sans rien installer : sqlite:///./bsd_ai.db
DATABASE_URL=postgresql+psycopg2://bsd_ai:bsd_ai@localhost:5432/bsd_ai

# Ligues à suivre (league_id BSD, séparés par des virgules). OBLIGATOIRE :
# le scheduler refuse de tourner sans scope (voir ingestion/scheduler.py) —
# suivre TOUTES les ligues dépasse le quota gratuit de plusieurs ordres de
# grandeur (calcul dans le README).
#
# Top 5 européen + quelques autres, IDs confirmés sur l'API réelle (2026-09-20) :
#   Premier League=1, Serie A=4, La Liga=3, Bundesliga=5, Ligue 1=6,
#   Liga Portugal Betclic=2, Trendyol Super Lig=11, Swiss Super League=15
BSD_LEAGUE_IDS=1,4,3,5,6,2,11,15

# Nombre de matchs live max suivis en parallèle (protection rate limit)
MAX_CONCURRENT_LIVE=50
